{
  "name": "demo",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -k -n api,web -c blue,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun run --watch src/index.ts",
    "dev:web": "cd web && bun run dev",
    "setup": "bun install && cd web && bun install"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "elysia": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "concurrently": "^10.0.6"
  },
  "module": "src/index.js"
}
