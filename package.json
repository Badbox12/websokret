{
  "name": "websokret-api",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time chat API: Bun + Elysia + WebSocket + MongoDB",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "elysia": "^1.4.30",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "typescript": "^5.9.3"
  }
}
